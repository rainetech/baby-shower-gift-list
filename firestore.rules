rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any address can sign itself up in this Firebase project (a default Firebase setting, separate
    // from this site's own code, which never offers sign-up). So "signed in at all" is not enough:
    // this checks the signed-in account's email against the one fixed registry address, which is
    // also what the recovery steps use when the account is deleted and recreated for a forgotten
    // PIN, so this rule never needs to change when that happens.
    function isRegistryGuest() {
      return request.auth != null
        && request.auth.token.email == "registry@rochelle-and-christopher.example";
    }

    match /registries/rochelle-and-christopher/reservations/{itemId} {
      allow read: if isRegistryGuest();

      allow create: if isRegistryGuest()
        && request.resource.data.keys().hasOnly(["itemId", "name", "reservedAt"])
        && request.resource.data.itemId == itemId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && request.resource.data.reservedAt == request.time;

      allow update, delete: if false;
    }
  }
}
